    # Agency. https://doi.org/10.2909/8BFBDA74-7B62-4659-96DD-86600EA425A2
  
# NOTE: substituted for TCD 2018-present (10 m) due to CLMS processing delay
  # on the original order (as of [date]). 2015 is the closest available
  # epoch; tree cover density is not expected to change drastically over
  # a 3-4 year gap outside of major fire/logging events.
  # Tiles used: E40N20 (northern/central Italy) + E40N10 (southern Italy) + E50N10
  
# Calling the raw data
  tree_cover_N20 <- rast("/Volumes/Storage/raw_data/tree_E40N20.tif")
