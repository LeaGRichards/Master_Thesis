  # Specifically: 2017 maps of cattle, horse, sheep and goat densities

# Calling the raw data and checking the info
  cattle <- rast("/Volumes/Storage/raw_data/cattle.tif")
  crs(cattle) # EPSG:4326
  res(cattle) # 0.04491576 degrees
