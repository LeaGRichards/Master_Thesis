  tree_cover_E50 <- rast("/Volumes/Storage/raw_data/tree_E50N10.tif")
  crs(tree_cover_N20) # EPSG:3035
  crs(tree_cover_N10) # EPSG:3035
  crs(tree_cover_E50) # EPSG:3035
  
# Merge all 3 tiles into one raster
  tree_cover <- merge(tree_cover_N20, tree_cover_N10, tree_cover_E50)
  global(tree_cover, c("min","max"), na.rm=TRUE) # raster values from 0 to 100
  
# Limiting to continental Italy
  tree_cover_it <- mask(crop(tree_cover, italy_cont), italy_cont) 
  plot(tree_cover_it, main = "Tree cover density 10m") # There is no scale and the colour is green and white, which is wrong
  
# Remove the embedded colour table so plot() treats values as continuous
