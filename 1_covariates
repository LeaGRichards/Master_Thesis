# Note: from previous attempts, the dataset is huge and is very hard to process.

# Creating a rectangle shape including Italy
  italy_box <- ext(italy_cont_4326)
  # The dataset of roads is much too big for R to process so I will call the 
  # data of only this box and paved roads

# Calling the raw data of roads
  roads_paved_it <- vect("/Volumes/Storage/raw_data/roads.shp",
    query = "SELECT * FROM roads WHERE GP_RSE = 1", extent = italy_box)
