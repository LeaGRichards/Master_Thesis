##################################
### Preparing trails covariate ###
##################################  

# Covariate
  # trails : Proportion of occupation by unpaved roads and pedestrian trails (50m)

# Source:
  # OpenStreetMap contributors. (2017). OpenStreetMap: Italy [Map]. 
    # https://download.geofabrik.de/europe/italy.html
  # Tags to consider: 
    # Highway -> highway=track; highway=footway; highway=path;
    # Surface -> surface=ground; surface=unpaved; surface=gravel; surface=grass; 
      # surface=compacted; surface=dirt; surface=fine_gravel; surface=pebblestone; 
      # surface=earth; surface=sand
    # Tracktype -> tracktype=grade2; tracktype=grade3; tracktype=grade4; tracktype=grade5

# Calling the raw data
  trails <- oe_read("/Volumes/Storage/raw_data/trails.osm.pbf", layer = "lines",
    extra_tags = c("surface", "tracktype")) # Highway is automatically called
  st_crs(trails) #EPSG:4326
  head(trails) # Interesting

# Keeping only the desired tags
  surface_types <- c("ground","unpaved","gravel","grass","compacted","dirt", 
    "fine_gravel","pebblestone","earth","sand")
  highway_types <- c("living_street", "unclassified","residential","service", 
    "road", "tertiary", "secondary", "primary", "pedestrian", "cycleway")
    # Types of highway that the surface type has to be specified
  
  filter_trail <- with(trails,
    highway %in% c("path","footway", "bridleway", "track") |
    (highway %in% highway_types & surface %in% surface_types) |
    tracktype %in% c("grade2","grade3","grade4","grade5") )
  
  trails_filtered <- trails[filter_trail, ]

# Changing trails from a SimpleFeature (sf) to a SpatVector to use terra functions
  trails_v <- vect(trails_filtered)

# Limiting to continental Italy
  trails_it <- crop(trails_v, italy_cont_4326)
  # using crop then mask reduces the processing work

# Re-projecting to EPSG:3035
  trails_it_3035 <- project(trails_it, "EPSG:3035")

# Saving as raw Italy data
  terra::writeVector(trails_it_3035,
    filename = "/Volumes/Storage/raw_italy_data/trails_it_3035.gpkg", overwrite = TRUE)

# Rasterizing the total polyline length per cell
  trails_length_r  <- rasterizeGeom(trails_it_3035, template, fun = "length")

# Setting NAs to zero
  freq(is.na(trails_length_r)) # There are no NA values
  trails_length_r  <- subst(trails_length_r,  NA, 0) # Run if there are NAs

# Limiting again to continental Italy (subst will fill the sea cells)  
  trails_length_r  <- mask(crop(trails_length_r,  italy_cont), italy_cont)

# Converting lengths to proportions (m/m2) (50m cell is 2500m2)
  trails_prop_r <- trails_length_r / 2500
  global(trails_prop_r, c("min", "max", "mean"), na.rm = TRUE) # 0 0.266569 0.001434407
# Checking that all is good
  plot(trails_prop_r) # Looks good :)
  crs(trails_prop_r) # EPSG:3035
  res(trails_prop_r) # 50m

# Saving raster as processed data
  terra::writeRaster(trails_prop_r, 
    filename = "/Volumes/Storage/data_processed/trails_it.tif", overwrite = TRUE)
    # "overwrite = TRUE" allows R to replace any file with the same existing name 

#######################################
### Preparing settlements covariate ###
#######################################  

# Covariate
  # Settlements: Proportion of occupation by human settlements (50m)

# Source:
  # European Environment Agency. (2020). Impervious Built-up 2018 (raster 10 m), 
    # Europe, 3-yearly, Aug. 2020 (Version 01.00) [GeoTIFF]. European Environment 
    # Agency. https://doi.org/10.2909/3E412DEF-A4E6-4413-98BB-42B571AFD15E
  # Data is made of many files -> mosaic style

# Calling the raw data (all the tif files)
  tif_files <- list.files("/Volumes/Storage/raw_data/sett", pattern = "\\.tif$", full.names = TRUE)
  length(tif_files) # 74 files

# Creating a virtual raster dataset (VRT) 
  sett <- vrt(tif_files, "/Volumes/Storage/raw_data/sett/sett_full.vrt", overwrite = TRUE)

# Checking the data
  minmax(sett) # 0 to 255
  plot(sett) # Looks interesting, there are some yellow dots and the ocean is blocky black
  crs(sett) # EPSG 3035 = good
  freq(sett) # Only 0, 1, and 255 occur
  # Based on the "IBU_2018_010m_QGISColour.txt" file accompanying the dataset:
  # 0 = non-built-up
  # 1 = built-up
  # 254 = un-classifiable
  # 255 = outside the area
  # 2 - 253 = filler

# Changing outside areas to NAs
  sett_0_1 <- classify(sett, cbind(255, NA)) 
  freq(sett_0_1) # Only 1 and 0 now

# Resampling the 10m data to fit the 10m template grid
  sett_10m <- resample(sett_0_1, template_10m, method = "near",
    filename = "/Volumes/Storage/raw_italy_data/sett_10m.tif", overwrite = TRUE)
    # Method "near" as it<s categorical data (0 or 1)

# Limiting to continental Italy
  sett_it_10m <- mask(sett_10m, italy_cont)  
  # Not crop as it would later misalign the 10m template-aligned cells to template

# Checking that all is good
  plot(sett_it_10m) # Looks good (0 and 1 only)

# Using the 10m cells as subraster of 50m cells to calculate proportion of occupation 
  # 5 x 5 10m cells sub raster, aggregated to 50m cells with proportion of 1 vs NA
  res(sett_it_10m) # 10m
  sett_prop <- aggregate(sett_it_10m, fact = 5, fun = mean, na.rm = TRUE)
    # na.rm = TRUE to avoid considering in the mean the NA cells of the ocean and other

# Checking that the grid still aligns to template
  compareGeom(sett_prop, template, stopOnError = FALSE) # TRUE = good
  global(sett_prop, c("min", "max"), na.rm = TRUE) # between 0 and 1 = good
  plot(sett_prop) # Looks good, scale from 0 to 1

# Saving as processed data
  terra::writeRaster(sett_prop, 
    filename = "/Volumes/Storage/data_processed/sett_50m.tif", overwrite = TRUE)
    # "overwrite = TRUE" allows R to replace any file with the same existing name 

