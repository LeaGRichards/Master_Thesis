  horse <- rast("/Volumes/Storage/raw_data/horse.tif")
  crs(horse) # EPSG:4326
  res(horse) # 0.04491576 degrees
  global(horse,c("min","max", "mean"), na.rm=TRUE) # From 0.001960799 to 2369.398, mean of 0.615297
  
  sheep <- rast("/Volumes/Storage/raw_data/sheep.tif")
  crs(sheep) # EPSG:4326
  res(sheep) #
