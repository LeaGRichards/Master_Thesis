  plot(tree_cover_it, main = "Tree cover density 10m") # scale present, normal colours, looks good
  
# Aligning to the 50m template grid
  tree_cover_50m <- resample(tree_cover_it, template, method = "bilinear")
  plot(tree_cover_50m, main = "Tree cover density 50m")
  print(tree_cover_50m) # 0 to 100, EPSG:3035, 50m
  
# Saving raster as processed data
  terra::writeRaster(tree_cover_50m, 
    filename = "/Volumes/Storage/data_processed/tree_cover_50m.tif", overwrite = TRUE)
