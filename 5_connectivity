      v.names = "density", # Name of the new combined density column
      timevar = "surface",  # Name for the new combined surface column
      times = names(density_vals)) # Valyes to fill the "surface" column
    
  # Testing for normality of distribution of the surface densities 
    
      # p-value is > 0.05, surfaces are not normally distributed
    
  # Kruskal-wallis
      # Non-parametric, does not require a normal distribution
      # Works with ranks -> chi-squared
      # Null hypothesis H0: all surfaces are similar
      # If significant = means at least one surface differs significantly from the others (not which)
      # 
    
    kw_density <- kruskal.test(density ~ surface, data = density_long)
